---
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { capture } from '../showcase';
// Animated SVGs, built with castwright from site/captures/audit*.terminal.yaml: an excerpt of
// examples/report.ansi, the real report for tests/fixtures/bad (see site/captures/excerpt.sh).
// The narrow scene has 48 columns, so the text stays readable on phones.
import auditNarrowSvg from '../../captures/audit-narrow.svg?url';
import auditSvg from '../../captures/audit.svg?url';

const astroConfig = `import { defineConfig } from 'astro/config';
import sitemap from '@astrojs/sitemap';
import postAudit from '@casoon/astro-post-audit';

export default defineConfig({
  site: 'https://example.com',
  integrations: [
    sitemap(),
    // after sitemap(): the audit checks the generated sitemap
    postAudit({ preset: 'standard', failOn: 'errors' }),
  ],
});`;
---

<Base>
  <Hero
    title="Audit what you actually ship."
    lead="astro-post-audit runs after every astro build and checks the finished dist/ output: SEO signals, broken internal links and lightweight WCAG heuristics. Static analysis in a Rust binary, no browser, no network calls unless you enable external link checks."
  >
    <Install
      commands={[
        { label: 'npm', command: 'npm i -D @casoon/astro-post-audit' },
        { label: 'pnpm', command: 'pnpm add -D @casoon/astro-post-audit' },
        { label: 'yarn', command: 'yarn add -D @casoon/astro-post-audit' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>npm {config.version}</Badge>
      <Badge>Astro 5, 6, 7</Badge>
      <Badge>Node 18+</Badge>
    </Badges>
    <picture slot="output">
      <source media="(max-width: 640px)" srcset={auditNarrowSvg} width="427.2" height="530" />
      <img
        class="terminal-demo"
        src={auditSvg}
        width="561.6"
        height="440"
        alt="Terminal, excerpt of the real report astro-post-audit prints after the build for the test fixture tests/fixtures/bad: Errors 14, Warnings 7, Info 4, Files 1. Top issue rules: landmarks/content-outside 4 times, links/broken 3 times, buttons/name-missing, canonical/missing and document/lang-missing once each. Then the first two findings for index.html: a missing canonical tag, with the remedy to set site in astro.config.mjs and render a canonical link in the BaseHead component, and a broken internal link to /broken-page/, with the remedy to verify the route in src/pages or the Content Collection slug."
      />
    </picture>
  </Hero>

  <Facts
    items={[
      { value: '32', label: 'checks per run, listed by progress: verbose' },
      { value: '8', label: 'presets, from relaxed to production' },
      { value: '4', label: 'report formats: JSON, Markdown, SARIF, HTML' },
      { value: '5', label: 'platforms with prebuilt binaries' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Checks the output, not the source',
        body: 'Canonicals, sitemap, robots.txt, hreflang, Open Graph and JSON-LD are read from the generated files, so the audit sees what search engines and visitors get.',
      },
      {
        title: 'Shared accessibility rules',
        body: 'Accessibility and document rules come from the shared a11y-rules crates, the same ones behind auditmysite and LiveAudit, so a finding has one id everywhere. Contrast is reported as not testable instead of passed.',
      },
      {
        title: 'Remedies in Astro terms',
        body: 'Each finding names the rule, the element and a fix that points to BaseHead, astro:assets, Astro.site or your Content Collections.',
      },
      {
        title: 'Rolls out gradually',
        body: 'Presets, per-rule severity, a baseline that reports only new findings, and a go-live gate that catches staging domains and noindex before production.',
      },
    ]}
  />

  <BuildOutput
    heading="Captured from the test fixtures"
    caption="A baseline recorded for a clean site, then one page added: the report lists only the new page. Every output on this site is a real run of the audit binary against the fixtures in tests/fixtures, captured with examples/capture.sh."
    file="examples/baseline.ansi"
  >
    <Terminal ansi={capture('baseline.ansi')} />
  </BuildOutput>

  <Quickstart
    lead="Install, register the integration, build."
    steps={[
      'Install <code>@casoon/astro-post-audit</code> as a dev dependency.',
      'Add <code>postAudit()</code> to the integrations in <code>astro.config.mjs</code>, after <code>sitemap()</code>.',
      'Run <code>astro build</code>. The report follows the build; <code>failOn</code> decides whether findings fail it.',
    ]}
  >
    <CodeBlock code={astroConfig} lang="js" title="astro.config.mjs" label="JavaScript" />
  </Quickstart>
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
</style>
